# Local operator env (npx supabase start). Do not commit real secrets.
# After `npx supabase start`, copy values from `npx supabase status -o env`.
#
# Hosted Pilot uses a separate gitignored file or Dashboard values.
# See docs/hosted-pilot.md. Never put service_role in clinic-review or the mobile app.
# Keep this file on 127.0.0.1 when working locally.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# service_role bypasses RLS. Use only for local operators/tests. Never ship it in the mobile app
# or the clinic dashboard.

# clinic-review browser env (copy into clinic-review/.env.local). Never put service_role here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional fallback only if the publishable key is unset:
# VITE_SUPABASE_ANON_KEY=
